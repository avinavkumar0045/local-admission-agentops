flowchart LR

%% ═══════════════════════════════════════════
%%  A · USER INTERFACE & EXPLAINABILITY
%% ═══════════════════════════════════════════
subgraph A["  A · User Interface & Presentation  "]
    direction TB
    STUDENT(["👤 Student / User"])
    STREAMLIT("🎓 Streamlit Web Application\n(Chat Interface)")
    SOURCES("📄 Explainability Panel\n(Source Documents & Relevance Scores)")
    
    STUDENT <-->|"Ask Query / Receive Answer"| STREAMLIT
    STREAMLIT -->|"Displays Retrieved Citations"| SOURCES
end

%% ═══════════════════════════════════════════
%%  B · AI APPLICATION & ORCHESTRATION
%% ═══════════════════════════════════════════
subgraph B["  B · AI Application & Orchestration  "]
    direction TB
    FASTAPI("⚙️ FastAPI Backend\n(Query Handler & Orchestrator)")
    QWEN("🤖 Local Qwen 2.5 LLM\n(Ollama Runtime)")
    
    FASTAPI <-->|"Prompt with Context / Generated Answer"| QWEN
end

%% ═══════════════════════════════════════════
%%  C · KNOWLEDGE BASE & RETRIEVAL (RAG)
%% ═══════════════════════════════════════════
subgraph C["  C · Knowledge Base & Retrieval  "]
    direction TB
    DOCS[/"📂 Admission Documents\n(PDFs, CSVs, Excel, Markdown)"/]
    EMBED("🧮 Sentence Transformer\n(all-MiniLM-L6-v2 Embeddings)")
    FAISS[("🗂️ FAISS Vector Index\n(991 Semantic Chunks)")]
    
    DOCS -.->|"Offline Ingestion & Chunking"| EMBED
    EMBED <-->|"Vector Search / Top-3 Chunks"| FAISS
end

%% ═══════════════════════════════════════════
%%  D · AGENTOPS OBSERVABILITY & ALERTING
%% ═══════════════════════════════════════════
subgraph D["  D · AgentOps Observability & Monitoring Layer  "]
    direction LR
    OTEL("📡 OpenTelemetry SDK\n(11-Span Contract)")
    COLLECTOR("🔁 OTel Collector\n(Docker:4317)")
    TEMPO[("⏱️ Grafana Tempo\n(Distributed Traces)")]
    MYSQL[("🗄️ MySQL Database\n(Span Metrics & Logs)")]
    GRAFANA("📊 Grafana Dashboard\n& Alert Engine")
    ALERTRX("🚨 Alert Receiver\n(Webhook:5050)")
    
    OTEL ==>|"OTLP / gRPC"| COLLECTOR
    COLLECTOR ==>|"Trace Export"| TEMPO
    TEMPO -->|"TraceQL Explorer"| GRAFANA
    MYSQL -->|"SQL Metrics"| GRAFANA
    GRAFANA -->|"Trigger on Failure"| ALERTRX
end

%% ═══════════════════════════════════════════
%%  PRIMARY INTER-MODULE CONNECTIONS
%% ═══════════════════════════════════════════
STREAMLIT <==>|"HTTP POST /query  &  JSON Response"| FASTAPI

FASTAPI <==>|"Semantic Query / Retrieved Context"| EMBED

%% Telemetry Stream (Application to Observability)
FASTAPI ==>|"Telemetry Spans"| OTEL
FASTAPI ==>|"SQL INSERT Span Records"| MYSQL

