%% ═══════════════════════════════════════════
%%  A · USER INTERFACE & PRESENTATION
%% ═══════════════════════════════════════════
subgraph A["  A · User Interface & Presentation  "]
    direction TB
    n5(["Student / User"])
    n2["Streamlit Web Application\n(Chat Interface)"]
    n11["Explainability Panel\n(Source Documents & Relevance Scores)"]
    
    n5 -->|Ask Query| n2
    n2 -->|Receive Answer| n5
    n2 -->|Displays Retrieved Citations| n11
end

%% ═══════════════════════════════════════════
%%  B · AI APPLICATION & ORCHESTRATION
%% ═══════════════════════════════════════════
subgraph B["  B · AI Application & Orchestration  "]
    direction TB
    n0["FastAPI Backend\n(Query Handler & Orchestrator)"]
    n8["Local Qwen 2.5 LLM\n(Ollama Runtime)"]
    n14["Structured Fast-Path Engine\n(42ms Deterministic Routing)"]
    
    n0 -->|Prompt with Context| n8
    n8 -->|Generated Answer| n0
    n0 -->|Evaluate / Dispatch| n14
end

%% ═══════════════════════════════════════════
%%  C · KNOWLEDGE BASE & RETRIEVAL (RAG)
%% ═══════════════════════════════════════════
subgraph C["  C · Knowledge Base & Retrieval  "]
    direction TB
    n6[/"Admission Documents\n(PDFs, CSVs, Excel, Markdown)"/]
    n4["Sentence Transformer\n(all-MiniLM-L6-v2 Embeddings)"]
    n9[("FAISS Vector Index\n(1,176 Semantic Chunks)")]
    
    n6 -.->|Offline Ingestion & Chunking| n4
    n4 -->|Vector Search / Top-3 Chunks| n9
    n9 -->|Relevant Context Passages| n4
end

%% ═══════════════════════════════════════════
%%  D · AGENTOPS OBSERVABILITY & MONITORING
%% ═══════════════════════════════════════════
subgraph D["  D · AgentOps Observability & Monitoring Layer  "]
    direction LR
    n10["OpenTelemetry SDK\n(11-Span Contract & RAG-Triad)"]
    n3["OTel Collector\n(Docker:4317)"]
    n1[("Grafana Tempo\n(Distributed Traces)")]
    n7[("MySQL Database\n(Span Metrics & Semantic Evals)")]
    n12["Grafana Dashboard\n& Alert Engine"]
    n13["Alert Receiver\n(Webhook:5050)"]
    
    n10 -->|OTLP / gRPC| n3
    n3 -->|Trace Export| n1
    n1 -->|TraceQL Explorer| n12
    n7 -->|SQL Metrics & Evals| n12
    n12 -->|Trigger on Failure| n13
end

